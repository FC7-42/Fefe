# Copie ce fichier en .env et remplis-le avec les valeurs de
# https://www.strava.com/settings/api
STRAVA_CLIENT_ID=ton_client_id
STRAVA_CLIENT_SECRET=ton_client_secret
# Doit correspondre exactement à l'"Authorization Callback Domain"
# de ton app Strava (ex. localhost -> http://localhost:5000/callback)
STRAVA_REDIRECT_URI=http://localhost:5000/callback
FLASK_SECRET_KEY=une_chaine_aleatoire_longue
